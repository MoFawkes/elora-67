{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t: value: gift_card.initial_value | money }} &ndash; {{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  </head>
  <body class="template-gift-card">
    <main class="password">
      <div class="password__inner">
        <p class="hero__eyebrow">{{ shop.name }}</p>
        <h1 class="hero__title gold-text">{{ gift_card.initial_value | money }}</h1>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="badge badge--muted">{{ 'gift_card.expired' | t }}</p>
        {%- endif -%}
        {%- if gift_card.balance != gift_card.initial_value -%}
          <p>{{ 'gift_card.remaining' | t: balance: gift_card.balance | money }}</p>
        {%- endif -%}
        <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
        <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
        <p><a href="{{ shop.url }}" class="button button--outline-gold">{{ 'gift_card.shop_link' | t }}</a></p>
        <button type="button" class="link" onclick="window.print();">{{ 'gift_card.print' | t }}</button>
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
