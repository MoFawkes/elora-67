    {%- liquid
      assign heading_font = settings.type_heading_font
      assign body_font = settings.type_body_font
      assign body_font_bold = body_font | font_modify: 'weight', 'bold'
    -%}

    {%- if settings.use_display_fonts -%}
      {%- # theme-check-disable RemoteAsset -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Great+Vibes&display=swap" rel="stylesheet">
      {%- # theme-check-enable RemoteAsset -%}
    {%- endif -%}


    {% style %}
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}

      :root {
        --color-primary: {{ settings.color_primary }};
        --color-primary-dark: {{ settings.color_primary_dark }};
        --color-primary-contrast: {{ settings.color_primary_contrast }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-light: {{ settings.color_accent_light }};
        --color-accent-contrast: {{ settings.color_accent_contrast }};
        --color-background: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-text: {{ settings.color_text }};
        --color-text-muted: {{ settings.color_text | color_mix: settings.color_background, 65 }};
        --color-border: {{ settings.color_text | color_mix: settings.color_background, 15 }};
        --color-sale: {{ settings.color_sale }};

        --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-style: {{ heading_font.style }};
        --font-heading-weight: {{ heading_font.weight }};
        --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body-style: {{ body_font.style }};
        --font-body-weight: {{ body_font.weight }};
        --font-body-weight-bold: {{ body_font_bold.weight | default: 700 }};

        --font-display-family: {% if settings.use_display_fonts %}'Cinzel', {% endif %}var(--font-heading-family);
        --font-script-family: {% if settings.use_display_fonts %}'Great Vibes', {% endif %}var(--font-heading-family);
        --logo-width: {{ settings.logo_width }}px;

        --page-width: {{ settings.page_width }}px;
        --radius: {{ settings.button_radius }}px;
      }
    {% endstyle %}

