{%- comment -%}
  Store logo: the image uploaded in theme settings, or the bundled Elora 67 logo.
{%- endcomment -%}
{%- if settings.logo != blank -%}
  {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio | round -%}
  {{
    settings.logo
    | image_url: width: 600
    | image_tag:
      class: 'logo__image',
      width: settings.logo_width,
      height: logo_height,
      alt: shop.name,
      loading: 'eager',
      sizes: '(min-width: 750px) 300px, 160px'
  }}
{%- else -%}
  {%- assign logo_height = settings.logo_width | times: 415 | divided_by: 800 -%}
  <img
    src="{{ 'elora67-logo.webp' | asset_url }}"
    class="logo__image"
    width="{{ settings.logo_width }}"
    height="{{ logo_height }}"
    alt="{{ shop.name | escape }}"
    loading="eager"
  >
{%- endif -%}
