<section class="section collection-tiles-section" {{ section.shopify_attributes }}>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="collection-tiles" role="list" style="--tile-count: {{ section.blocks.size | at_least: 1 }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign tile_image = block.settings.image | default: collection.featured_image
          assign tile_title = block.settings.title | default: collection.title
          assign tile_url = block.settings.link | default: collection.url | default: routes.collections_url
        -%}
        <li class="collection-tile" {{ block.shopify_attributes }}>
          <a href="{{ tile_url }}" class="collection-tile__link">
            <div class="collection-tile__media">
              {%- if tile_image != blank -%}
                {{ tile_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 17vw, 50vw', widths: '360, 540, 720, 900', alt: tile_title }}
              {%- else -%}
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'collection-tile__placeholder' }}
              {%- endif -%}
            </div>
            <div class="collection-tile__content">
              <h3 class="collection-tile__title">{{ tile_title | default: 'Collection' | escape }}</h3>
              <span class="collection-tile__cta">{{ block.settings.link_label | escape }} {% render 'icon', name: 'arrow-right' %}</span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collection tiles",
  "class": "section-collection-tiles",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Overrides the collection image. Portrait 3:4 works best." },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the collection." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Women" } },
        { "type": "tile", "settings": { "title": "Men" } },
        { "type": "tile", "settings": { "title": "Kids" } },
        { "type": "tile", "settings": { "title": "Fabrics" } },
        { "type": "tile", "settings": { "title": "New Arrivals" } },
        { "type": "tile", "settings": { "title": "Brand", "link_label": "Our story" } }
      ]
    }
  ]
}
{% endschema %}
