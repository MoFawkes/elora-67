{%- assign collection = section.settings.collection -%}
<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-heading-row">
      <h2 class="section-heading">{{ section.settings.heading | default: collection.title | escape }}</h2>
      {%- if collection != blank -%}
        <a href="{{ collection.url }}" class="link-arrow">{{ 'general.view_all' | t }} {% render 'icon', name: 'arrow-right' %}</a>
      {%- endif -%}
    </div>
    <ul class="product-grid product-grid--{{ section.settings.columns }}" role="list">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <li>{% render 'product-card', product: nil, placeholder_index: i %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
