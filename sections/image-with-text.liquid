{%- assign s = section.settings -%}
<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width image-with-text{% if s.image_position == 'right' %} image-with-text--reverse{% endif %}">
    <div class="image-with-text__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400' }}
      {%- elsif s.bundled_image != blank -%}
        <img src="{{ s.bundled_image | asset_url }}" alt="Floral belted blazer and matching trousers" width="1024" height="1536" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'image-with-text__placeholder' }}
      {%- endif -%}
    </div>
    <div class="image-with-text__content">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="section-heading">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="button">{{ s.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "class": "section-image-with-text",
  "settings": [
    {"type": "text", "id": "bundled_image", "label": "Bundled image filename", "default": "elora-floral-suit.jpg"},
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select", "id": "image_position", "label": "Image position", "default": "left",
      "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Modesty, crafted with elegance" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Elora 67 brings together timeless silhouettes, rich fabrics and thoughtful coverage — for women, men and little ones who want to look and feel their best.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover more" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
