<section class="password">
  <div class="password__inner">
    <div class="logo">{% render 'logo' %}</div>
    {%- if shop.password_message != blank -%}<p class="password__message">{{ shop.password_message }}</p>{%- endif -%}
    <p class="hero__script">{{ 'password.coming_soon' | t }}</p>

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="search-pill">
          <input type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.placeholder' | t }}">
          <button type="submit" aria-label="{{ 'newsletter.submit' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>{{ 'password.enter_using_password' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors.messages.form }}</p>{%- endif -%}
        <label for="Password" class="visually-hidden">{{ 'password.password' | t }}</label>
        <div class="search-pill">
          <input type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
          <button type="submit" aria-label="{{ 'password.enter' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Password page", "class": "section-main-password", "settings": [] }
{% endschema %}
